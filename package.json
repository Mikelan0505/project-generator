{
  "name": "project-generator",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "generate:sample": "python script.py --template website --project sample --force",
    "lint:html:templates": "html-validate \"templates/**/*.html\"",
    "lint:html:sample": "npm run generate:sample && html-validate \"outputs/sample/**/*.html\"",
    "lint:html": "npm run lint:html:templates && npm run lint:html:sample",
    "test:python": "python -m unittest discover -s tests -q",
    "check": "npm run lint:html && npm run test:python"
  },
  "devDependencies": {
    "html-validate": "10.17.0"
  }
}
